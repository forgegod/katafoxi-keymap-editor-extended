# Local sibling/zmk-config bridge (/layout, /keymap): set ENABLE_LOCAL=true
# GITHUB_OAUTH_CALLBACK_URL must be the browser-facing origin (Vite proxy in dev),
#   e.g. http://127.0.0.1:5173/github/authorize — NOT :8080 — so sid cookies attach.
# Prod: same-origin {APP_BASE_URL}/github/authorize
# Auth decision: docs/adr/0003-github-auth-server-session.md

GITHUB_APP_ID=
GITHUB_APP_NAME=
# PEM with literal \n for newlines, or a quoted multiline block.
# GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
APP_BASE_URL=http://127.0.0.1:5173
ENABLE_GITHUB=false
ENABLE_LOCAL=false
PORT=8080
# HOST=127.0.0.1
# Behind a reverse proxy, set TRUST_PROXY=true so GitHub rate limits use
# X-Forwarded-For / X-Real-IP. Leave unset locally so clients cannot spoof
# those headers to bypass the per-IP cap (socket address is used instead).
# TRUST_PROXY=true
# Vite serves the SPA in `pnpm dev`; set true to skip the missing web dist warning.
# ENABLE_DEV_SERVER=true
# Optional. Default is <repo>/zmk-config. The e2e smoke sets a temp fixture copy.
# ZMK_CONFIG_PATH=

/*
 * Hard .keymap corpus: #define in tapping-term-ms, key-positions, layers,
 * if-layers, and a backslash-continued alias used in a combo binding.
 * Covers R2-2 (omit unparsed blocks so Save keeps macros) and R2-7 (join `\`).
 */

#define TT 2\
80
#define LT0 0
#define LT1 1
#define BASE 0
#define LOWER 0
#define RAISE 1
#define ESC_KEY ESC

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            tapping-term-ms = <TT>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <LT0 LT1>;
            layers = <BASE>;
        };
        combo_tab {
            bindings = <&kp ESC_KEY>;
            key-positions = <2 3>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri {
            if-layers = <LOWER RAISE>;
            then-layer = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp A &kp B
&kp C &kp D
            >;
        };

        layer_1 {
            bindings = <
&trans &trans
&trans &trans
            >;
        };
    };
};

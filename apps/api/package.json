{
  "name": "@keymap-editor/api",
  "version": "0.1.0",
  "private": true,
  "description": "Private workspace package; not independently versioned.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src/** --coverage.exclude=**/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@keymap-editor/keymap-core": "workspace:*",
    "hono": "^4.6.14",
    "http-link-header": "^1.1.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/http-link-header": "^1.0.7",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "2.1.9",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8"
  }
}

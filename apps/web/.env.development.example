# Copy to apps/web/.env.development. That file is gitignored.
# Match VITE_ENABLE_LOCAL to ENABLE_LOCAL in the repo-root .env.
# Match VITE_ENABLE_GITHUB and VITE_GITHUB_APP_NAME to ENABLE_GITHUB and GITHUB_APP_NAME.
# In dev, VITE_APP_BASE_URL must be the Vite origin (127.0.0.1, not localhost)
# so the session cookie sticks. See running-locally.md.

VITE_ENABLE_LOCAL=false
VITE_ENABLE_GITHUB=false
VITE_GITHUB_APP_NAME=
VITE_API_BASE_URL=
VITE_APP_BASE_URL=http://127.0.0.1:5173

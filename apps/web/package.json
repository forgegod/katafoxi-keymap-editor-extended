{
  "name": "@keymap-editor/web",
  "private": true,
  "version": "0.1.0",
  "description": "Private workspace package; not independently versioned.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src/** --coverage.exclude=**/*.test.ts",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "svelte-check --tsconfig ./tsconfig.app.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@keymap-editor/keymap-core": "workspace:*",
    "fuzzysort": "^3.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "2.1.9",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^15.11.7",
    "svelte": "^5.17.0",
    "svelte-check": "^4.1.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}

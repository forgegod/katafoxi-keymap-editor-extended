# Production secrets for docker compose (gitignored as deploy/.env).
# Do not commit real values. Local GitHub App stays in the repo-root .env.

APP_BASE_URL=https://zmk-keymap-editor.com
GITHUB_OAUTH_CALLBACK_URL=https://zmk-keymap-editor.com/github/authorize

# Must match the production GitHub App slug (and compose build arg).
VITE_GITHUB_APP_NAME=keymap-editor-extended
GITHUB_APP_NAME=keymap-editor-extended
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PEM with literal \n for newlines, e.g. "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_PRIVATE_KEY=

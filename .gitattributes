# Canonical text in the repo is LF on every OS.
# Windows Git still checks out LF; editors follow .editorconfig.
* text=auto eol=lf

# Native CRLF fixture for keymap splice round-trips (T1-3).
packages/keymap-core/fixtures/corpus/crlf.keymap text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pem binary
